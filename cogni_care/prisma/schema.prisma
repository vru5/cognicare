// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(cuid())
  name String?
  role String
  logs SymptomLog[]
}

model SymptomLog {
  id String @id @default(cuid())
  createdAt DateTime @default(now())
  patientId String
  rawText String

  physical String?
  mood String?
  cognitive String?
  sleep String?
  social String?

  patient User @relation(fields: [patientId], references: [id])
}