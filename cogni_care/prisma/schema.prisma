generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String          @id @default(cuid())
  name      String?
  email     String?         @unique
  phone     String?
  role      String?
  password  String?
  createdAt DateTime        @default(now())
  carer     ProfileCarer?
  patient   ProfilePatient?

  @@map("users")
}

model ProfilePatient {
  id            String             @id
  userId        String             @unique
  createdAt     DateTime           @default(now())
  pushToken     String?
  carerNotes    CarerNote[]
  carers        CarersOnPatients[]
  familyMembers FamilyMember[]
  user          User               @relation(fields: [userId], references: [id])
  logs          SymptomLog[]

  @@map("patient_profiles")
}

model ProfileCarer {
  id        String             @id
  userId    String             @unique
  createdAt DateTime           @default(now())
  pushToken String?
  notes     CarerNote[]
  symptomLogs SymptomLog[]
  user      User               @relation(fields: [userId], references: [id])
  patients  CarersOnPatients[]

  @@map("carer_profiles")
}

model FamilyMember {
  id        String         @id @default(cuid())
  name      String
  email     String?
  phone     String
  patientId String
  patient   ProfilePatient @relation(fields: [patientId], references: [id])

  @@map("family_members")
}

model CarersOnPatients {
  carerId           String
  patientId         String
  lastViewedAt      DateTime       @default(now())
  accessCareCircle  Boolean        @default(true)
  accessSymptomLogs Boolean        @default(true)
  carer             ProfileCarer   @relation(fields: [carerId], references: [id])
  patient           ProfilePatient @relation(fields: [patientId], references: [id])

  @@id([carerId, patientId])
  @@map("carers_on_patients")
}

model SymptomLog {
  id                String         @id @default(cuid())
  createdAt         DateTime       @default(now())
  patientId         String
  rawText           String
  isFromCarer       Boolean        @default(false)
  carerId           String?
  carer             ProfileCarer?  @relation(fields: [carerId], references: [id])
  physical          String?
  mood              String?
  cognitive         String?
  sleep             String?
  social            String?
  cognitiveSeverity Int?
  moodSeverity      Int?
  physicalSeverity  Int?
  sleepSeverity     Int?
  socialSeverity    Int?
  notes             CarerNote[]
  patient           ProfilePatient @relation(fields: [patientId], references: [id])

  @@map("symptom_logs")
}

model CarerNote {
  id        String         @id @default(cuid())
  createdAt DateTime       @default(now())
  text      String
  logId     String?
  carerId   String
  patientId String
  carer     ProfileCarer   @relation(fields: [carerId], references: [id])
  log       SymptomLog?    @relation(fields: [logId], references: [id])
  patient   ProfilePatient @relation(fields: [patientId], references: [id])

  @@map("carer_notes")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

model DoctorFormCache {
  patientId String   @id
  hash      String
  data      Json
  updatedAt DateTime @updatedAt

  @@map("doctor_form_cache")
}

model ProfessionalReportCache {
  patientId String
  dateA     String
  dateB     String
  hash      String
  data      Json
  updatedAt DateTime @updatedAt

  @@id([patientId, dateA, dateB])
  @@map("professional_report_cache")
}
model AiInsightCache {
  patientId String
  startDate String
  endDate   String
  hash      String
  data      Json
  updatedAt DateTime @updatedAt

  @@id([patientId, startDate, endDate])
  @@map("ai_insight_cache")
}
