generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(cuid())
  name     String?
  email    String? @unique
  phone    String?
  role     String? // "PATIENT" or "CARER"
  password String? // bcrypt hash
  createdAt DateTime @default(now())

  patient ProfilePatient?
  carer   ProfileCarer?

  @@map("users")
}

model ProfilePatient {
  id             String          @id
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id])
  familyMembers  FamilyMember[]
  carers         CarersOnPatients[]
  logs           SymptomLog[]
  carerNotes     CarerNote[]
  createdAt      DateTime        @default(now())
  pushToken      String?

  @@map("patient_profiles")
}

model ProfileCarer {
  id       String             @id
  userId   String             @unique
  user     User               @relation(fields: [userId], references: [id])
  patients CarersOnPatients[]
  notes    CarerNote[]
  createdAt DateTime           @default(now())
  pushToken String?

  @@map("carer_profiles")
}

model FamilyMember {
  id        String         @id @default(cuid())
  name      String
  email     String?
  phone     String
  patientId String
  patient   ProfilePatient @relation(fields: [patientId], references: [id])

  @@map("family_members")
}

model CarersOnPatients {
  carerId      String
  patientId    String
  lastViewedAt DateTime       @default(now())
  
  accessSymptomLogs Boolean @default(true)
  accessCareCircle  Boolean @default(true)

  carer        ProfileCarer   @relation(fields: [carerId], references: [id])
  patient      ProfilePatient @relation(fields: [patientId], references: [id])

  @@id([carerId, patientId])
  @@map("carers_on_patients")
}

model SymptomLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  patientId String
  rawText   String

  physical  String?
  physicalSeverity Int?
  mood      String?
  moodSeverity     Int?
  cognitive String?
  cognitiveSeverity Int?
  sleep     String?
  sleepSeverity    Int?
  social    String?
  socialSeverity   Int?

  patient   ProfilePatient @relation(fields: [patientId], references: [id])
  notes     CarerNote[]

  @@map("symptom_logs")
}

model CarerNote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  text      String
  
  // Optional: If present, it's a comment on a specific log
  logId     String?
  log       SymptomLog? @relation(fields: [logId], references: [id])
  
  carerId   String
  carer     ProfileCarer @relation(fields: [carerId], references: [id])

  patientId String
  patient   ProfilePatient @relation(fields: [patientId], references: [id])

  @@map("carer_notes")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}
