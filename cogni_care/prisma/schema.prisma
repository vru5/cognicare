generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(cuid())
  name     String?
  email    String? @unique
  phone    String?
  role     String? // "PATIENT" or "CARER"
  password String? // bcrypt hash

  patient ProfilePatient?
  carer   ProfileCarer?

  @@map("users")
}

model ProfilePatient {
  id             String          @id
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id])
  familyMembers  FamilyMember[]
  carers         CarersOnPatients[]
  logs           SymptomLog[]

  @@map("patient_profiles")
}

model ProfileCarer {
  id       String             @id
  userId   String             @unique
  user     User               @relation(fields: [userId], references: [id])
  patients CarersOnPatients[]

  @@map("carer_profiles")
}

model FamilyMember {
  id        String         @id @default(cuid())
  name      String
  email     String?
  phone     String
  patientId String
  patient   ProfilePatient @relation(fields: [patientId], references: [id])

  @@map("family_members")
}

model CarersOnPatients {
  carerId   String
  patientId String
  carer     ProfileCarer   @relation(fields: [carerId], references: [id])
  patient   ProfilePatient @relation(fields: [patientId], references: [id])

  @@id([carerId, patientId])
  @@map("carers_on_patients")
}

model SymptomLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  patientId String
  rawText   String

  physical  String?
  mood      String?
  cognitive String?
  sleep     String?
  social    String?

  patient   ProfilePatient @relation(fields: [patientId], references: [id])

  @@map("symptom_logs")
}
